{
  "name": "@classroom/server",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "API, SFU and background worker.",
  "main": "src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./app": "./src/app.js"
  },
  "scripts": {
    "dev": "node --watch --env-file=../.env src/server.js",
    "dev:sfu": "node --watch --env-file=../.env src/mediasoup/index.js",
    "dev:worker": "node --watch --env-file=../.env src/worker.js",
    "start": "node src/server.js",
    "migrate": "node --env-file=../.env src/db/migrate.js up",
    "migrate:status": "node --env-file=../.env src/db/migrate.js status",
    "lint": "eslint src",
    "test": "vitest run",
    "test:contract": "vitest run --dir test/contract",
    "clean": "rimraf node_modules .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/client-secrets-manager": "^3",
    "@aws-sdk/client-ses": "^3",
    "@aws-sdk/client-sns": "^3",
    "@aws-sdk/client-transcribe": "^3",
    "@aws-sdk/cloudfront-signer": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@classroom/contracts": "*",
    "@opentelemetry/auto-instrumentations-node": "^0.62",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203",
    "@opentelemetry/sdk-node": "^0.203",
    "@socket.io/redis-adapter": "^8",
    "bullmq": "^5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8",
    "ioredis": "^5",
    "jose": "^6",
    "mediasoup": "^3",
    "nodemailer": "^6",
    "pg": "^8",
    "pino": "^9",
    "socket.io": "^4",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6",
    "zod": "^4"
  },
  "devDependencies": {
    "pino-pretty": "^13",
    "supertest": "^7"
  }
}
